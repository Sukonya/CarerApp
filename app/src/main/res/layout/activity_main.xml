<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:gravity="center">

    <FrameLayout
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:background="@drawable/circle_logo_bg"
        android:layout_marginBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="CarerApp"
            android:textColor="@color/primary"
            android:textSize="16sp"
            android:textStyle="bold"/>

    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Care, Connected."
        android:textColor="@color/text_secondary"
        android:textSize="16sp"
        android:layout_marginBottom="64dp"/>

    <Button
        android:id="@+id/btnFamily"
        android:layout_width="300dp"
        android:layout_height="56dp"
        android:text="@string/role_family"
        android:textColor="@color/white"
        android:backgroundTint="@color/btn_family"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnCarer"
        android:layout_width="300dp"
        android:layout_height="56dp"
        android:text="@string/role_carer"
        android:textColor="@color/text_primary"
        android:backgroundTint="@color/surface_variant"
        android:textSize="13sp"
        android:textStyle="bold"/>

</LinearLayout>